<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="mod-report-snapshots-1" author="developer">
        <createTable tableName="mod_report_snapshots">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="snapshot_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="scope" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="report_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="total_mods" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="total_games" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="mod_report_snapshots"
                             columnNames="snapshot_date, scope"
                             constraintName="uq_mod_report_snapshot_date_scope"/>
    </changeSet>

</databaseChangeLog>
